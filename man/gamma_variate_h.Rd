\name{gamma_variate_h}
\alias{gamma_variate_h}
\title{Evaluate a gamma-variate response}
\description{Evaluate a gamma-variate response.}
\usage{
gamma_variate_h(time, tD, tP, alpha)
}
\arguments{
  \item{time}{Times at which to evaluate the response.}
  \item{tD}{Response onset time.}
  \item{tP}{Time of peak response.}
  \item{alpha}{Shape parameter.}
}
\value{A numeric vector of response values.}
